{
  "ai": {
    "provider": "anthropic",
    "model": "claude-sonnet-5",
    "api_key_env": "ANTHROPIC_API_KEY",
    "temperature": 1.0,
    "max_tokens": 4096,
    "throttle_sec": 0,
    "analysis_concurrency": 2,
    "enrichment_concurrency": 1,
    "languages": [
      "en"
    ]
  },
  "processing": {
    "profiles_dir": "profiles",
    "default_profile": "practice",
    "profile_settings": {
      "business-markets": {
        "threshold": 7.0,
        "topic_dedup": true
      },
      "practice": {
        "threshold": 6.5,
        "topic_dedup": true
      },
      "horizon-research": {
        "threshold": 8.0,
        "topic_dedup": true
      },
      "guardrails": {
        "threshold": 7.0,
        "topic_dedup": true
      }
    }
  },
  "display": {
    "icon_style": "emoji"
  },
  "email": {
